{
  // Same extend-and-include shape as backend/test/tsconfig.json: the app's
  // own options, widened to cover test/ so `tsc -b` actually type-checks the
  // tests instead of skipping a directory no project includes.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    // Widened from tsconfig.app.json's browser-only ["vite/client"]: the
    // static print.css check reads the stylesheet off disk with node:fs, the
    // way backend/test/route-reachability.test.ts does. Only this project is
    // widened — tsconfig.app.json still builds src/ without node types, so a
    // source file reaching for a node API keeps failing the production build.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test"]
}
