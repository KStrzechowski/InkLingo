# Committed on purpose, unlike .env.development / .env.production: CI writes a
# real .env.production from deployed stack outputs in the same job that runs
# the tests. Vite only loads .env, .env.local and the files for the *current*
# mode, so a `test` run never reads .env.production at all — and would still
# prefer this file over a generic .env for the same key. These dummy values are
# what a test run sees either way.
VITE_API_BASE_URL=http://localhost:3000
VITE_COGNITO_USER_POOL_ID=eu-central-1_testplaceholder
VITE_COGNITO_CLIENT_ID=testplaceholderclientid
VITE_COGNITO_DOMAIN=https://test-placeholder.auth.eu-central-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_REGION=eu-central-1
