# Copy to .env.development (local backend) or .env.production (deployed
# API) and fill in. Same VITE_* convention as frontend/ — these are the
# public Cognito identifiers, not secrets, but they differ per
# environment so the files stay untracked.
#
# VITE_API_BASE_URL       — http://localhost:3000 locally, or the ApiUrl
#                           output of InkLingo-ApiStack.
# VITE_COGNITO_DOMAIN     — the CognitoHostedUiDomain output of
#                           InkLingo-AuthStack (no trailing slash).
# VITE_COGNITO_CLIENT_ID  — the UserPoolClientId output of the same stack.
#
# Both host origins must also be covered by manifest.json's
# host_permissions, or the background script's fetch calls are blocked.
VITE_API_BASE_URL=http://localhost:3000
VITE_COGNITO_DOMAIN=https://ink-lingo-<account-id>.auth.eu-central-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<user-pool-client-id>
